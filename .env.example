# ── Sortify AI configuration ────────────────────────────────────────────────
# Sortify works out of the box in Demo Mode without any keys.
# Add ONE of the keys below to enable live AI classification.

# Google Gemini (recommended — generous free tier): https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# OpenAI fallback (optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# Anti-abuse limits (defaults shown)
# AI_RATE_LIMIT_PER_IP=10
# AI_RATE_LIMIT_GLOBAL=1000
# DEMO_RATE_LIMIT_PER_IP=60

# Enable the bench kiosk API when Next.js is bound to localhost.
# SORTIFY_BENCH=1
