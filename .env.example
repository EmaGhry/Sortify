# Run the Python station with --model-url to enable live scanning.
# Optional, used only by the separate translation script.
# GOOGLE_AI_API_KEY=

# Anti-abuse limits (defaults shown)
# AI_RATE_LIMIT_PER_IP=10
# AI_RATE_LIMIT_GLOBAL=1000
# DEMO_RATE_LIMIT_PER_IP=60

# Enable the bench kiosk API when Next.js is bound to localhost.
# SORTIFY_BENCH=1
