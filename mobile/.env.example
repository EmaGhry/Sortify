# Base URL of the Sortify API (the Next.js app from the repo root).
# Leave empty in Expo Go dev — the app auto-derives the LAN host running `expo start`.
# For a deployed backend (recommended): https://your-sortify.vercel.app
EXPO_PUBLIC_API_URL=

# Example for demoing against a laptop dev server:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
