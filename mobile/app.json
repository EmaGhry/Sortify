{
  "expo": {
    "name": "Sortify",
    "slug": "sortify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sortify",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Sortify uses the camera to scan recyclable objects."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.broscoi.sortify"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sortify folosește camera pentru a scana obiecte reciclabile. / Sortify uses the camera to scan recyclable objects.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sortify accesează fotografiile pentru a analiza imagini existente. / Sortify accesses photos to analyze existing images."
        }
      ],
      "expo-localization",
      "expo-build-properties",
      "./plugins/withPermissionsCleanup.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7bd669a0-b662-4b21-9266-729f585167d7"
      }
    },
    "owner": "broscoi"
  }
}
