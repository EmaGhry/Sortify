{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@shared/*": ["../lib/*"],
      "@locales/*": ["../locales/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../lib/**/*.ts",
    "../locales/*.json"
  ],
  "exclude": ["../lib/i18n.tsx", "../lib/rate-limit.ts"]
}
